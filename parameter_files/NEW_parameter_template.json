{
    "model_name" : "test_working_fully_year",
    "verbose": true,
    "parallel_loading": false,
    "train_load_data" : {
        "year":"2015",
        "freq":10,
        "region":"BRAZIL",
        "size":20,
        "met_args":{"met_levels":[3, 15,21]}
    },

    "test_load_data" : {
        "year":"201601",
        "freq":15
    },

    "variables" : {
        "met_variables":{"x_wind":[3,15], "y_wind":[3,15], "upward_air_velocity":[3,15], "atmosphere_boundary_layer_thickness":[], "surface_air_pressure":[]},
        "static_variables":["lat_coords", "lon_coords", "topog", "binary_centre"],
        "time_deltas":[6]
    },

    "input_scaler" : {
        "scaler":"DefaultInputsScaler",
        "fit_on_subsample":0.8,
        "scaler_params":{}
    },

    "fp_scaler": {
        "scaler":"LogAndShiftMeanFpScaler",
        "scaler_params":{}
    },


    "dataloader":{
        "batch_size": 5,
        "test_batch_size": 10,
        "nans_to_zeros": true,
        "dataloader_params": {
            "prefetch_factor": 2,
            "num_workers": 2,
            "persistent_workers": true,
            "multiprocessing_context": "forkserver"}} ,

    "_ignore_dataloader_params":  {           "prefetch_factor": 3,
            "num_workers": 2,
            "persistent_workers": true,
            "multiprocessing_context": "forkserver"},
            
    "model_parameters":{
        "num_blocks":1, 
        "node_dim":64, 
        "edge_dim":64, 
        "hidden_layers_processor_node":2, 
        "hidden_layers_processor_edge":2,  
        "hidden_layers_decoder":1, 
        "hidden_dim_processor_node":16, 
        "hidden_dim_processor_edge":16, 
        "hidden_dim_decoder":16, 
        "resolution":4, 
        "output_dim":1, 
        "residuals":false, 
        "attention":false
    },

    "learning_rate":5e-5,

    "use_wandb":true,
    "wandb": {
        "project": "gates-tests",
        "entity": "gates-lab"
    },

    "epochs" : {
        "training": 12,
        "visualize": 5,
        "patience": 3,
        "model_save": 50
    },    

    "loss_functions" : {
        "criterion": "gates_losses.MSELoss",
        "criterion_params": {},
        "criterion_test": "gates_losses.MSELoss",
        "criterion_test_params": {}
    }   
}