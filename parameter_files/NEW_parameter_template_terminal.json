{
    "model_name" : "terminal_test_zarr_flux",
    "verbose": true,
    "load_before_training": true,
    "notes": "Tiny single-region smoke test: SAHARA, 10x10 domain, one month train / one month test, zarr met + flux.",
    "train_load_data" : {
        "years":["2015"],
        "months":["01"],
        "freq":20,
        "region":"SAHARA",
        "size":10,
        "crop_met": false
    },

    "test_load_data" : {
        "years":["2016"],
        "months":["01"],
        "freq":70
    },

    "review_fixes": {
        "fix_grid_transpose": true,
        "use_tensor_loader": true
    },

    "flux":{
        "get_flux":true,
        "convert_units":true,
        "convert_units_args":{"unit_multiplier":1e9}
    },

    "variables" : {
        "met_variables":["x_wind", "y_wind", "atmosphere_boundary_layer_thickness", "atmosphere_downward_eastward_stress", "atmosphere_downward_northward_stress", "specific_humidity", "surface_upward_sensible_heat_flux"],
        "met_levels":[3],
        "static_variables":["lat_coords", "lon_coords", "topog", "xy_distance_centre"],
        "time_deltas":[3],
        "chunk_size":3,
        "load_into_memory":false,
        "interp_to": "3h"
    },

    "input_scaler" : {
        "scaler":"DefaultInputsScaler",
        "fit_on_subsample":0.25,
        "scaler_params":{}
    },

    "fp_scaler": {
        "scaler":"LogAndShiftFpScaler",
        "scaler_params":{}
    },

    "dataloader":{
        "batch_size": 2,
        "test_batch_size": 2,
        "nans_to_zeros": true,
        "dataloader_params": {
            "prefetch_factor": 0,
            "num_workers": 0}
    },

    "model_parameters":{
        "num_blocks":1,
        "node_dim":64,
        "edge_dim":64,
        "hidden_layers_processor_node":2,
        "hidden_layers_processor_edge":2,
        "hidden_layers_decoder":1,
        "hidden_dim_processor_node":16,
        "hidden_dim_processor_edge":16,
        "hidden_dim_decoder":16,
        "resolution":4,
        "output_dim":1,
        "residuals":false,
        "attention":false,
        "initial_enc": true,
        "use_dynamic_encoder":false
    },

    "learning_rate":5e-5,

    "use_wandb":false,

    "epochs" : {
        "training": 1,
        "visualize": 5,
        "patience": 3,
        "model_save": 50
    },

    "loss_functions" : {
        "criterion": "gates_losses.PixelWeightedMSELoss",
        "criterion_params": {
            "weight_label": "fp_original",
            "transform_fn": "scale_and_shift",
            "w": 1000,
            "a": 1.0
        },
        "criterion_test": "gates_losses.MSELoss",
        "criterion_test_params": {}
    }
}
