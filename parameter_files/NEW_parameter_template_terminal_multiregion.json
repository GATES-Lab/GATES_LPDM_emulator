{
    "model_name" : "terminal_test_multiregion",
    "verbose": true,
    "parallel_loading": false,
    "load_into_memory": true,
    "load_data_monthly": true,

    "regions": {
        "0": {
            "train_load_data": {
                "years": ["2015"], "months": ["01", "03"],
                "freq": 20,
                "region": "SAHARA"
            },
            "test_load_data": {
                "years": ["2017"], "months": ["01"],
                "freq": 60
            }
        },
        "1": {
            "train_load_data": {
                "years": ["2015"], "months": ["02"],
                "freq": 20,
                "region": "SAHARA"
            },
            "test_load_data": {
                "years": ["2017"], "months": ["02"],
                "freq": 60
            }
            }
        },
    

    "shared_load_parameters": {
        "size": 10,
        "met_args": {
            "met_levels": [3],
            "met_variables": ["x_wind"]
        }
    },

    "variables" : {
        "met_variables":["x_wind"],
        "met_levels":[3],
        "static_variables":["lat_coords", "lon_coords", "topog", "xy_distance_centre"],
        "time_deltas":[]
    },

    "input_scaler" : {
        "scaler":"DefaultInputsScaler",
        "fit_on_subsample":0.25,
        "scaler_params":{}
    },

    "fp_scaler": {
        "scaler":"LogAndShiftFpScaler",
        "scaler_params":{}
    },

    "dataloader":{
        "batch_size": 2,
        "test_batch_size": 2,
        "nans_to_zeros": true,
        "dataloader_params": {
            "prefetch_factor": 0,
            "num_workers": 0}
    },

    "_ignore_dataloader_params": {
            "prefetch_factor": 3,
            "num_workers": 4,
            "persistent_workers": true,
            "multiprocessing_context": "forkserver"},

    "model_parameters":{
        "num_blocks":1,
        "node_dim":64,
        "edge_dim":64,
        "hidden_layers_processor_node":2,
        "hidden_layers_processor_edge":2,
        "hidden_layers_decoder":1,
        "hidden_dim_processor_node":16,
        "hidden_dim_processor_edge":16,
        "hidden_dim_decoder":16,
        "resolution":4,
        "output_dim":1,
        "residuals":false,
        "attention":false
    },

    "learning_rate":5e-5,

    "use_wandb":false,
    "wandb": {
        "project": "gates-tests-multiregion",
        "entity": "gates-lab"
    },

    "epochs" : {
        "training": 8,
        "visualize": 5,
        "patience": 3,
        "model_save": 50
    },

    "loss_functions" : {
        "criterion": "gates_losses.PixelWeightedMSELoss",
        "criterion_params": {"weight_label":"fp_original", "transform_fn":"scale_and_shift", "w":1000, "a":0.5},
        "criterion_test": "gates_losses.MSELoss",
        "criterion_test_params": {}
    }
}
