{
    "model_name" : "test_MHD",
    "train_load_data" : {
        "year":"2015",
        "freq":4,
        "site":"MHD",
        "size":50,
        "verbose":true,
        "fp_datadir":"/group/chemistry/acrg/LPDM/fp_NAME_pre20210701/EUROPE/MHD-10magl_EUROPE_",
        "met_args":{"met_datadir":"/group/chemistry/acrg/met_archive/NAME/EUROPE_met/EUROPE_Met_10magl_"}
    },

    "test_load_data" : {
        "year":"2017",
        "freq":8
    },

    "variables" : {
        "met_variables":{"Wind_Speed":[], "Wind_Direction":[], "Temperature":[], "PBLH":[]},
        "static_variables":["lat_coords", "lon_coords", "topog", "landcover"],
        "time_deltas":[6,12]
    },

    "dataloader_parameters":{
        "input_transforms":["clever_transform_3"],
        "output_transforms":["logv4"]  
    },

    "model_parameters":{
        "num_blocks":4, 
        "node_dim":64, 
        "edge_dim":64, 
        "hidden_layers_processor_node":1, 
        "hidden_layers_processor_edge":1,  
        "hidden_layers_decoder":1, 
        "hidden_dim_processor_node":16, 
        "hidden_dim_processor_edge":16, 
        "hidden_dim_decoder":16, 
        "resolution":4, 
        "output_dim":1, 
        "residuals":false, 
        "attention":false
    },

    "learning_rate":5e-5,

    "loss_functions" : {
        "criterion": "MSE_weighted_by_truth_nans(multiply_by_add, w=1000)",
        "criterion_test": "torch.nn.MSELoss()"
    }    
}