{
    "model_name" : "SAHARA_gpu_freq3_2year50_fullinputs_PixelWeightedMSELoss_a05_shuffled",
    "verbose": true,
    "parallel_loading": true,
    "load_into_memory": true,
    "_ignore_model_save_dir": "/user/work/ef17148/GCN/graphnet/graphnet_LPDM_emulator/test_jobs/working_GPU_experiments",
    "train_load_data" : {
        "year":"2014",
        "freq":100,
        "region":"BRAZIL",
        "size":50,
        "met_args":{"met_levels":[3, 9], 
    "met_variables":["x_wind", "y_wind" ]},
