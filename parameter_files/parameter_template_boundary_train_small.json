        "attention":false
    },

    "learning_rate":5e-5,
    "use_wandb":true,
    "wandb": {
        "project": "BoundaryCondition-Prediction",
        "entity": "gates-lab",
        "tags": ["SAHARA", "gpu", "PixelWeightedMSELoss"]
    },

    "epochs" : {
        "training": 250,
        "visualize": 10,
        "patience": 100,
        "model_save": 50
    },    

    "loss_functions" : {
        "criterion": "gates_losses.PixelWeightedMSELoss",
        "criterion_params": {"weight_label":"fp_original", "transform_fn":"scale_and_shift", "w":1000, "a":0.5},
        "criterion_test": "gates_losses.MSELoss",
        "criterion_test_params": {}
    }  
      
}



