        "scaler_params":{}
    },


    "dataloader":{
        "batch_size": 5,
        "test_batch_size": 5,
        "nans_to_zeros": true,

        "dataloader_params": {
                "prefetch_factor": 3,
                "num_workers": 2,
                "pin_memory": true,
                "persistent_workers": true,
                "multiprocessing_context": "forkserver",
            "shuffle": true}
    },

    "model_parameters":{
        "num_blocks":4, 
        "node_dim":64, 
        "edge_dim":64, 
        "hidden_layers_processor_node":2, 
        "hidden_layers_processor_edge":2,  
