{
    "model_name" : "test_working_terminal",
    "verbose": true,
    "parallel_loading": true,
    "load_into_memory": true,
    "load_data_monthly": true,
    "domain": "NORTHAFRICA",
    "train_load_data" : {
        "year": "2015",
        "months": ["01","02", "03","04", "05","06", "07","08", "09","10", "11","12"],
        "freq": 20,
        "region": "SAHARA",
        "size": 50,
        "boundary": true,
        "met_args": {
            "met_levels": [3, 9, 15, 21, 30, 42, 51],
            "met_variables": ["x_wind", "y_wind", "upward_air_velocity", "atmosphere_boundary_layer_thickness", "surface_air_pressure", "air_temperature", "air_pressure"]
        }
    },

    "test_load_data" : {
        "year": "2016",
        "months": ["01","02", "03","04", "05","06", "07","08", "09","10", "11","12"],
        "freq": 100
    },

    "variables" : {
        "met_variables": ["x_wind", "y_wind", "upward_air_velocity", "atmosphere_boundary_layer_thickness", "surface_air_pressure", "air_temperature", "air_pressure", "wind_speed", "wind_angle"],
        "met_levels": [3, 9, 15, 21, 30, 42, 51],
        "static_variables": ["sin_lat_coords", "sin_lon_coords", "cos_lat_coords", "cos_lon_coords", "lat_coords", "lon_coords", "x_coords", "y_coords", "xy_distance_centre", "topog", "land_cover"],
        "time_deltas": [6, 12],
        "add_wind_direction": true
    },

    "input_scaler" : {
        "scaler": "DefaultInputsScaler",
        "fit_on_subsample": 0.25,
        "scaler_params": {}
    },

    "fp_scaler": {
        "scaler": "LogAndShiftFpScaler",
        "scaler_params": {}
    },

    "dataloader": {
        "batch_size": 2,
        "test_batch_size": 2,
        "nans_to_zeros": true,
        "dataloader_params": {
            "prefetch_factor": 0,
            "num_workers": 0
        }
    },

    "_ignore_dataloader_params": {
        "prefetch_factor": 3,
        "num_workers": 4,
        "persistent_workers": true,
        "multiprocessing_context": "forkserver"
    },

    "model_parameters": {
        "num_blocks": 4,
        "node_dim": 64,
        "edge_dim": 64,
        "hidden_layers_processor_node": 2,
        "hidden_layers_processor_edge": 2,
        "hidden_layers_decoder": 1,
        "hidden_dim_processor_node": 16,
        "hidden_dim_processor_edge": 16,
        "hidden_dim_decoder": 16,
        "resolution": 4,
        "output_dim": 1,
        "residuals": false,
        "attention": false
    },

    "normalization": "all",
    "network_decoder": "conv",
    "use_baselines": true,
    "output_format": "corrected",
    "auxiliary": "multiple",
    "learning_rate": 0.00005,
    "num_classes": 1,

    "use_wandb": true,
    "wandb": {
        "project": "BoundaryCondition-Prediction",
        "entity": "gates-lab"
    },

    "epochs": {
        "training": 100,
        "visualize": 5,
        "patience": 100,
        "model_save": 50
    },

    "loss_functions": {
        "criterion": "torch.nn.MSELoss",
        "criterion_params": {},
        "criterion_test": "torch.nn.MSELoss",
        "criterion_test_params": {}
    }
}