{
    "model_name": "lossLS2_struct_g10",
    "verbose": true,
    "load_before_training": true,
    "notes": "StructuralLoss, mode=correlation, gamma=1.0. Stronger structural weight than LS1 to test how much pattern-agreement pressure helps before it distorts amplitudes.",
    "load_data_monthly": true,
    "train_load_data": {
        "years": [
            "2014",
            "2015"
        ],
        "freq": 3,
        "region": "SAHARA",
        "size": 50,
        "crop_met": false
    },
    "test_load_data": {
        "years": [
            "2016"
        ],
        "freq": 100
    },
    "review_fixes": {
        "fix_grid_transpose": true,
        "use_tensor_loader": true
    },
    "variables": {
        "met_variables": [
            "x_wind",
            "y_wind",
            "upward_air_velocity",
            "atmosphere_boundary_layer_thickness",
            "surface_air_pressure",
            "air_temperature",
            "air_pressure",
            "wind_speed",
            "wind_angle"
        ],
        "met_levels": [
            3,
            9,
            15,
            21,
            30,
            42,
            51
        ],
        "static_variables": [
            "sin_lat_coords",
            "sin_lon_coords",
            "cos_lat_coords",
            "cos_lon_coords",
            "lat_coords",
            "lon_coords",
            "x_coords",
            "y_coords",
            "earth_distance_centre",
            "xy_distance_centre",
            "topog",
            "landcover"
        ],
        "time_deltas": [
            6,
            12
        ],
        "add_wind_direction": true,
        "load_into_memory": false,
        "chunk_size": 64
    },
    "input_scaler": {
        "scaler": "DefaultInputsScaler",
        "scaler_params": {}
    },
    "fp_scaler": {
        "scaler": "LogAndShiftFpScaler",
        "scaler_params": {}
    },
    "dataloader": {
        "batch_size": 5,
        "test_batch_size": 5,
        "nans_to_zeros": true,
        "dataloader_params": {
            "prefetch_factor": 3,
            "num_workers": 2,
            "pin_memory": true,
            "persistent_workers": true,
            "multiprocessing_context": "forkserver",
            "shuffle": true
        }
    },
    "model_parameters": {
        "num_blocks": 4,
        "node_dim": 64,
        "edge_dim": 64,
        "hidden_layers_processor_node": 2,
        "hidden_layers_processor_edge": 2,
        "hidden_layers_decoder": 1,
        "hidden_dim_processor_node": 16,
        "hidden_dim_processor_edge": 16,
        "hidden_dim_decoder": 16,
        "resolution": 4,
        "output_dim": 1,
        "residuals": false,
        "attention": false
    },
    "learning_rate": 5e-05,
    "use_wandb": true,
    "wandb": {
        "project": "gates-loss-deblur",
        "entity": "gates-lab",
        "tags": [
            "SAHARA",
            "gpu",
            "loss-deblur",
            "structural"
        ]
    },
    "epochs": {
        "training": 250,
        "visualize": 10,
        "patience": 100,
        "model_save": 50
    },
    "loss_functions": {
        "criterion": "gates_losses.StructuralLoss",
        "criterion_params": {
            "mode": "correlation",
            "gamma": 1.0
        },
        "criterion_test": "gates_losses.MSELoss",
        "criterion_test_params": {}
    }
}