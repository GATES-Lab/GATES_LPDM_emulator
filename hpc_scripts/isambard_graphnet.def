Bootstrap: docker
From: nvcr.io/nvidia/pytorch:24.01-py3

%post
    # Set up environment
    apt-get update && apt-get install -y git curl build-essential cmake libgl1-mesa-glx libglib2.0-0

    # Ensure pip is up to date
    python3 -m pip install --upgrade pip

    export TMPDIR=/tmp/build-tmp
    mkdir -p $TMPDIR

    # Install required Python packages
    pip install \
        torch==2.2.0a0+81ea7a4 \
        torch_geometric==2.6.1 \
        torch_scatter==2.1.2 \
        torch_sparse==0.6.18 \
        torch_cluster==1.6.3 \
        torch_spline_conv==1.2.2 \
        cartopy==0.22.0 \
        dask==2024.5.0 \
        einops==0.8.0 \
        h3==3.7.7 \
        h5py \
        matplotlib==3.8.4 \
        netCDF4==1.6.2 \
        numpy==1.26.4 \
        pandas==2.2.2 \
        scikit-learn==1.5.1 \
        scipy==1.13.1 \
        typing_extensions \
        xarray==2023.6.0

%environment
    # Set environment variables
    export PYTHONUNBUFFERED=1
    export MPLBACKEND=Agg

%runscript
    exec python3 "$@"

%labels
    Maintainer Jeff Clark
    Version isambard_graphnet-v1